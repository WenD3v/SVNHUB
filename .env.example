# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://svnhub:svnhub@localhost:5432/svnhub?schema=public

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# LDAP (opcional — deixe LDAP_URL vazio para usar apenas contas locais)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=(|(mail={email})(userPrincipalName={email}))

# Redis
REDIS_URL=redis://localhost:6379

# Runner
RUNNER_POLL_INTERVAL_MS=5000
RUNNER_SECRET=change-me-runner-secret
ARTIFACTS_STORAGE_PATH=./data/artifacts
API_INTERNAL_URL=http://localhost:4000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# SVN (paths relative to monorepo root)
SVN_REPOS_ROOT=data/repos
SVN_AUTHZ_PATH=data/svn-authz
SVN_PASSWD_PATH=data/svn-passwd
SVN_HTTP_URL=http://localhost:8080/svn
SVN_SVN_URL=svn://localhost/svn
SVN_CLI_TIMEOUT_MS=120000
INTERNAL_HOOK_SECRET=change-me-hook-secret
# When SVN runs in Docker and API on host (Windows/Mac): use host.docker.internal
API_INTERNAL_URL=http://host.docker.internal:4000

# Initial admin (pnpm db:seed)
ADMIN_EMAIL=admin@svnhub.local
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@123
ADMIN_DISPLAY_NAME=SVNHUB Admin

# Coolify (docker-compose.coolify.yml) — gerados automaticamente no painel:
# SERVICE_USER_POSTGRES, SERVICE_PASSWORD_POSTGRES, POSTGRES_DB
# SERVICE_PASSWORD_ADMIN, SERVICE_PASSWORD_JWT, SERVICE_PASSWORD_HOOK, SERVICE_PASSWORD_RUNNER
# SERVICE_URL_WEB, SERVICE_URL_API, SERVICE_URL_SVN (após configurar domínios)

# Binaries (optional — defaults to svn/svnadmin/svnlook on PATH)
# SVN_BIN=
# SVNADMIN_BIN=
# SVNLOOK_BIN=
